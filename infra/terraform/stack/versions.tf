terraform {
  # Write-only arguments and ephemeral resources need Terraform >= 1.11 (or OpenTofu >= 1.11).
  required_version = ">= 1.11.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 5.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.7"
    }
  }
}
